entrypoint = "main.py"
modules = ["nodejs-20", "python-3.10:v18-20230807-322e88b", "postgresql-16"]
hidden = [".pythonlibs"]
run = "sh deploy.sh"

[nix]
channel = "stable-23_05"
pkgs = ["python39Full", "poetry"]

[deployment]
run = ["python", "main.py"]
deploymentTarget = "cloudrun"

[env]
REPLIT_KEEP_PACKAGE_DEV_DEPENDENCIES = "1"
PYTHONPATH="."

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -c \"from my_flask_app import app; app.run(host='0.0.0.0', port=5000)\""
waitForPort = 5000

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080
